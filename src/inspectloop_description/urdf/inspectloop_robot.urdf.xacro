<?xml version="1.0"?>
<!--
  InspectLoop inspection AMR.
  Frames:  base_footprint (ground projection, odom child)
             └ base_link (wheel-axle height)
                 ├ left_wheel_link / right_wheel_link (continuous)
                 ├ front_caster_link / rear_caster_link (fixed, frictionless spheres)
                 ├ lidar_link            (2D gpu_lidar, scan frame)
                 └ camera_link           (x forward, REP-103 body frame)
                     └ camera_optical_link (z forward, image frame, REP-103 optical)
-->
<robot name="inspectloop" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="inertial_macros.xacro"/>

  <xacro:arg name="sim_mode" default="true"/>

  <!-- ===== Geometry parameters (metres / kilograms) ===== -->
  <xacro:property name="PI" value="3.141592653589793"/>
  <xacro:property name="chassis_length" value="0.50"/>
  <xacro:property name="chassis_width" value="0.38"/>
  <xacro:property name="chassis_height" value="0.18"/>
  <xacro:property name="chassis_mass" value="12.0"/>
  <xacro:property name="chassis_z" value="0.05"/>           <!-- centre above axle -->
  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.8"/>
  <xacro:property name="wheel_separation" value="0.46"/>    <!-- centre-to-centre -->
  <xacro:property name="caster_radius" value="0.04"/>
  <xacro:property name="caster_x" value="0.19"/>
  <xacro:property name="lidar_x" value="0.10"/>
  <xacro:property name="lidar_z" value="0.165"/>
  <xacro:property name="camera_x" value="0.255"/>
  <xacro:property name="camera_z" value="0.10"/>
  <xacro:property name="camera_pitch" value="-0.25"/>       <!-- negative = tilted up -->

  <material name="chassis_grey"><color rgba="0.25 0.27 0.30 1"/></material>
  <material name="safety_orange"><color rgba="0.95 0.45 0.05 1"/></material>
  <material name="rubber"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="sensor_black"><color rgba="0.10 0.10 0.12 1"/></material>

  <!-- ===== Base ===== -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z}"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 ${chassis_z + chassis_height/2 + 0.005}"/>
      <geometry><box size="${chassis_length - 0.04} ${chassis_width - 0.04} 0.01"/></geometry>
      <material name="safety_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z}"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
      <origin xyz="0 0 ${chassis_z}"/>
    </xacro:box_inertia>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}"/>
  </joint>

  <!-- ===== Drive wheels ===== -->
  <xacro:macro name="drive_wheel" params="side y_sign">
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="${-PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="rubber"/>
      </visual>
      <collision>
        <origin rpy="${-PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}">
        <origin rpy="${-PI/2} 0 0"/>
      </xacro:cylinder_inertia>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y_sign*wheel_separation/2} 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.01" friction="0.0"/>
    </joint>
    <gazebo reference="${side}_wheel_link">
      <collision>
        <surface>
          <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>
  <xacro:drive_wheel side="left" y_sign="1"/>
  <xacro:drive_wheel side="right" y_sign="-1"/>

  <!-- ===== Passive casters (frictionless spheres) ===== -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="sensor_black"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertia m="0.2" r="${caster_radius}"><origin xyz="0 0 0"/></xacro:sphere_inertia>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster_link"/>
      <origin xyz="${x} 0 ${caster_radius - wheel_radius}"/>
    </joint>
    <gazebo reference="${name}_caster_link">
      <collision>
        <surface>
          <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>
  <xacro:caster name="front" x="${caster_x}"/>
  <xacro:caster name="rear" x="${-caster_x}"/>

  <!-- ===== 2D LiDAR ===== -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.17" r="0.04" h="0.05"><origin xyz="0 0 0"/></xacro:cylinder_inertia>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} 0 ${lidar_z}"/>
  </joint>

  <!-- ===== RGB camera ===== -->
  <link name="camera_link">
    <visual>
      <origin xyz="-0.015 0 0"/>
      <geometry><box size="0.03 0.09 0.03"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <collision>
      <origin xyz="-0.015 0 0"/>
      <geometry><box size="0.03 0.09 0.03"/></geometry>
    </collision>
    <xacro:box_inertia m="0.08" x="0.03" y="0.09" z="0.03"><origin xyz="-0.015 0 0"/></xacro:box_inertia>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} 0 ${camera_z}" rpy="0 ${camera_pitch} 0"/>
  </joint>
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <xacro:if value="$(arg sim_mode)">
    <xacro:include filename="inspectloop_gazebo.xacro"/>
  </xacro:if>
</robot>
